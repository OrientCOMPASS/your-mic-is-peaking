{
  "id": "opss.your-mic-is-peaking",
  "name": "YourMicIsPeaking",
  "version": "1.0.0",
  "description": "One-key mic peaking: slams your mic into hard-clipping distortion while auto-matching the output loudness to the input, so it blows up without getting louder. Toggle with a global hotkey or the panel button.",
  "descriptionI18n": {
    "zh": "一键炸麦：把麦克风信号湿推入硬削波产生破音失真，输出响度自动匹配输入——只炸不变大声。全局快捷键或面板按钮一键开关。",
    "zh-CN": "一键炸麦：把麦克风信号湿推入硬削波产生破音失真，输出响度自动匹配输入——只炸不变大声。全局快捷键或面板按钮一键开关。"
  },
  "nameI18n": {
    "zh": "一键炸麦",
    "zh-CN": "一键炸麦"
  },
  "license": "Unlicense",
  "runtime": "native",
  "entry": "your_mic_is_peaking",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "arches": [
    "x86_64",
    "aarch64"
  ],
  "apiVersion": 1,
  "capabilities": [
    "dsp.node",
    "config.read",
    "config.write"
  ],
  "kind": "dsp",
  "dsp": {
    "insertAfter": "VAD",
    "realtimeSafe": true
  },
  "ui": {
    "route": "panel",
    "label": "YourMicIsPeaking",
    "panels": [
      {
        "id": "status",
        "label": "YourMicIsPeaking",
        "entry": "panel.html"
      }
    ]
  },
  "keywords": [
    "distortion",
    "clipping",
    "peaking",
    "loud",
    "effect",
    "dsp",
    "hotkey",
    "炸麦"
  ],
  "config": {
    "hotkey": "ctrl+shift+f9",
    "drive": 24,
    "mix": 1.0,
    "notify": true,
    "ymip_status": {
      "active": false,
      "drive": 24,
      "mix": 1.0,
      "hotkey": "ctrl+shift+f9",
      "hotkeyOk": false,
      "error": ""
    }
  },
  "configSchema": {
    "fields": [
      {
        "key": "hotkey",
        "fieldType": "string",
        "label": "全局快捷键 Hotkey",
        "description": "格式：修饰键 ctrl/alt/shift/win + 主键（a-z、0-9、f1-f24、space、enter 等），例如 ctrl+shift+f9。修改后立即生效（旧组合自动失效）。鼠标侧键暂不支持。",
        "default": "ctrl+shift+f9"
      },
      {
        "key": "drive",
        "fieldType": "number",
        "label": "炸裂强度 Drive",
        "description": "把信号推入硬削波的倍数：4 = 轻微破音，24 = 典型炸麦，64 = 完全方波。数值越大失真越猛（响度始终保持与输入一致）。",
        "min": 4,
        "max": 64,
        "step": 1,
        "default": 24
      },
      {
        "key": "mix",
        "fieldType": "number",
        "label": "效果比例 Mix",
        "description": "100% = 纯炸麦；调低可与干净信号按比例混合。",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "default": 1
      },
      {
        "key": "notify",
        "fieldType": "boolean",
        "label": "系统通知 Notifications",
        "description": "开启 / 关闭炸麦时弹出系统通知。",
        "default": true
      }
    ]
  },
  "repository": "https://github.com/OrientCOMPASS/your-mic-is-peaking",
  "homepage": "https://github.com/OrientCOMPASS/your-mic-is-peaking",
  "updateUrl": "https://github.com/OrientCOMPASS/your-mic-is-peaking/releases/latest/download/plugin.json",
  "downloadUrl": "https://github.com/OrientCOMPASS/your-mic-is-peaking/releases/latest/download/plugin.zip",
  "readmeUrl": "https://raw.githubusercontent.com/OrientCOMPASS/your-mic-is-peaking/refs/heads/main/README.md"
}
